# =============================================================================
# Document Embedding Manager - Environment configuration
# Copy to .env and adjust. Do NOT commit real secrets.
# =============================================================================

# Application -----------------------------------------------------------------
APP_VERSION=0.1.0
APP_NAME=Document Embedding Manager
APP_TIMEZONE=Europe/Berlin
# Comma separated list of FQDNs/IPs the app is reachable at (used for TLS CN/SAN).
APP_HOSTNAMES=localhost

# Ports -----------------------------------------------------------------------
# HTTPS (web) port exposed to the host. Only this port is published.
HTTPS_PORT=8443

# MySQL / MariaDB -------------------------------------------------------------
MYSQL_DATABASE=docvec
MYSQL_USER=docvec
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# Milvus ----------------------------------------------------------------------
MILVUS_HOST=milvus
# RESTful v2 API port (served on the proxy/gRPC port).
MILVUS_PORT=19530
# Metrics/liveness port (serves /healthz).
MILVUS_METRICS_PORT=9091

# Embedding service -----------------------------------------------------------
EMBEDDING_HOST=embedding
EMBEDDING_PORT=8000
# Comma separated: which models the `model-download` tool fetches into
# ./embedding/models (docker compose --profile tools run --rm model-download).
# The running embedding service never downloads; it only loads existing models.
EMBEDDING_MODELS=Qwen3-Embedding-0.6B
# Model loaded by the embedding service at start-up (must be downloaded).
EMBEDDING_DEFAULT_MODEL=Qwen3-Embedding-0.6B
# Optional proxy for the model-download tool only (left empty = direct).
#HTTP_PROXY=
#HTTPS_PROXY=
#NO_PROXY=

# Document converter ----------------------------------------------------------
CONVERTER_HOST=converter
CONVERTER_PORT=8001

# Host-side data directory (bind-mounted into the containers). ----------------
# Relative paths are resolved against the project root.
DATA_DIR=./data

# Container-side input root (the sandbox root for the directory browser and
# where scanned files live). These are paths *inside* the containers.
# Note: named INPUT_ROOT (not DOCUMENT_ROOT) to avoid colliding with the
# DOCUMENT_ROOT FastCGI variable that nginx passes to PHP.
INPUT_ROOT=/srv/data/input
# Upload / conversion staging area (container-side).
STAGING_ROOT=/srv/data/staging

# Limits ----------------------------------------------------------------------
# Max. size of a single uploaded file / import archive (PHP upload_max_filesize).
UPLOAD_MAX_SIZE=100M
# Max. size of a whole upload request (PHP post_max_size). Must not exceed
# nginx client_max_body_size (200m, web/nginx.conf).
POST_MAX_SIZE=200M
CONVERT_TIMEOUT=300

# Chunking defaults -----------------------------------------------------------
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=50
CHUNK_MAX_TOKENS=1024
# Number of chunk texts embedded per request to the embedding service.
EMBED_BATCH_SIZE=16

# Worker ----------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_BATCH_SIZE=16
WORKER_LOCK_TIMEOUT=1800

# Session / security ----------------------------------------------------------
# REQUIRED: at least 32 random characters, e.g. `openssl rand -hex 32`.
# Used to encrypt stored TLS private keys at rest. The app refuses to perform
# TLS operations while this is empty or still a "change-me" placeholder.
# Changing it later makes previously stored (encrypted) private keys unreadable.
SESSION_SECRET=change-me-session-secret
# Session lifetime in seconds: idle timeout / absolute maximum.
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200
# Login brute-force protection (failed attempts within the window).
LOGIN_MAX_ATTEMPTS_USER=5
LOGIN_MAX_ATTEMPTS_IP=20
LOGIN_THROTTLE_WINDOW=900

# Initial administrator -------------------------------------------------------
# Created by the `migrate` service on first start if no user exists yet.
# Password policy: >= 12 characters, not equal to the user name.
# Afterwards change the password in the UI (Einstellungen) or with
#   docker compose exec app php bin/set-password.php admin
# and remove ADMIN_PASSWORD from .env again.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO
